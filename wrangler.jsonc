// Déploiement Cloudflare (Workers) : l'appli (fichiers statiques) + la boîte aux lettres TRIGONE (worker.js, /api/…).
// Cloudflare le déploie tout seul depuis GitHub à chaque publication. Le stockage TRIGONE_KV est créé
// automatiquement au premier déploiement. Réglages à faire une fois dans Cloudflare : voir LISEZ-MOI.txt
// (secret BREVO_SMTP_CLE — ou BREVO_CLE / MAILJET_CLE + MAILJET_SECRET — à ajouter dans Cloudflare, jamais ici).
{
  "name": "trigone-mise-en-route",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "kv_namespaces": [{ "binding": "TRIGONE_KV" }],
  "d1_databases": [{ "binding": "TRIGONE_DB", "database_name": "trigone-boite" }],
  // IA de la mascotte d'aide (route aide/ia) : Workers AI, compris dans le compte Cloudflare (quota gratuit par jour).
  "ai": { "binding": "AI" },
  "vars": {
    "DOMAINES_AUTORISES": "",
    "EXPEDITEUR_MAIL": "noreply@trigone-app.com",
    "BREVO_SMTP_UTILISATEUR": "bb488f001@smtp-brevo.com"
  },
  "keep_vars": true,
  // Toutes les 5 minutes : nouvelle publication (notification « nouvelle version ») ; à l'heure pile, relance des valideurs et de l'assistant Chorus DT (demandes en attente depuis plus de 24 h).
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
