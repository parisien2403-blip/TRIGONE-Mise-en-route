// Déploiement Cloudflare (Workers) : l'appli (fichiers statiques) + la boîte aux lettres TRIGONE (worker.js, /api/…).
// Cloudflare le déploie tout seul depuis GitHub à chaque publication. Le stockage TRIGONE_KV est créé
// automatiquement au premier déploiement. Réglages à faire une fois dans Cloudflare : voir LISEZ-MOI.txt
// (BREVO_CLE en secret, EXPEDITEUR_MAIL en variable).
{
  "name": "trigone-mise-en-route",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "kv_namespaces": [{ "binding": "TRIGONE_KV" }],
  "vars": { "DOMAINES_AUTORISES": "interieur.gouv.fr" },
  "keep_vars": true,
  "observability": { "enabled": true }
}
