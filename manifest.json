{
  "id": "trigone-mise-en-route",
  "name": "TRIGONE",
  "short_name": "TRIGONE",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#E8F0F6",
  "theme_color": "#E8F0F6",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "description": "TRIGONE — mise en route et compte-rendu de mission",
  "share_target": {
    "action": "./partage-trigone",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titre",
      "text": "texte",
      "files": [
        {
          "name": "fichiers",
          "accept": [
            "*/*",
            "application/json",
            ".json",
            "application/octet-stream",
            "text/plain"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?fichier=1",
      "accept": {
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  }
}
